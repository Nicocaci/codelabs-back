# Copiá este archivo como .env y completá los valores
PORT=3000
MONGO_URL=mongodb+srv://usuario:password@cluster/codelabs
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
# Clave para crear/editar/borrar proyectos (header x-admin-key). Generala larga y aleatoria
ADMIN_API_KEY=
# Secreto para firmar JWT (cuando termines el login)
JWT_SECRET=

# --- Agendador (webhook de Cal.com, reemplaza a n8n) ---
# Parte secreta de la URL: https://<back>/webhooks/calcom/<CALCOM_WEBHOOK_TOKEN>
CALCOM_WEBHOOK_TOKEN=
# El "Secret" que cargás en el webhook de Cal.com (verifica la firma). Recomendado
CALCOM_WEBHOOK_SECRET=
# Bot de Telegram para los avisos
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Solo si los leads (codelabs-agents) están en otra base que MONGO_URL
LEADS_MONGO_URL=
